{
  "name": "trajeville",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de locação de trajes típicos alemães da Trajeville",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "tsx server/index.ts",
    "dev": "node scripts/build.mjs && tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && tsx --test tests/e2e/*.test.ts",
    "seed": "tsx server/seed.ts",
    "typecheck": "tsc --noEmit",
    "demo": "tsx server/seed.ts",
    "create-user": "tsx server/create-user.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.50.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}